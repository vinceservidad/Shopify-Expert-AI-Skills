    "@modelcontextprotocol/server": "2.2.0",
    "@shopify/shopify-api": "15.0.0",
    "express": "5.2.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.3",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
