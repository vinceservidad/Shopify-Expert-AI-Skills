{
  "name": "shopify-va-toolkit-connector",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only Shopify MCP connector for the independent Shopify VA Toolkit",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:package": "node tests/packaged-runtime.mjs",
    "build": "tsc && node build-plugin.mjs",
    "start": "node build/http.js",
    "stdio": "node build/stdio.js",
    "worker:catalog": "node --import tsx worker/build-catalog.ts",
    "worker:types": "wrangler types worker-configuration.d.ts --include-runtime=false --env-file worker/.env.example",
    "worker:typecheck": "npm run worker:catalog && npm run worker:types && tsc -p tsconfig.worker.json",
    "worker:build": "npm run worker:catalog && wrangler deploy --dry-run --outdir build/worker",
    "worker:dev": "npm run worker:catalog && wrangler dev",
    "worker:deploy": "npm run worker:catalog && wrangler deploy",
    "worker:test": "npm run worker:build && node tests/worker-runtime.mjs"
  },
  "license": "MIT",
  "repository": "https://github.com/vinceservidad/Shopify-Expert-AI-Skills",
  "dependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@modelcontextprotocol/express": "2.0.1",
    "@modelcontextprotocol/node": "2.1.0",
    "@modelcontextprotocol/server": "2.2.0",
    "@shopify/shopify-api": "15.0.0",
    "express": "5.2.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260930.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.3",
    "esbuild": "0.28.2",
    "miniflare": "5.20260926.1-alpha",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wrangler": "4.144.0"
  }
}
