{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shopify-va-toolkit",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "PUBLIC_URL": "https://shopify-va-toolkit.vinceluxxe.workers.dev"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "OAUTH_ISSUER",
        "class_name": "OAuthIssuer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "OAuthIssuer"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "7142001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "7142002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "minify": true,
  "account_id": "622e7a897cbb7babda383df6c1474e02"
}
