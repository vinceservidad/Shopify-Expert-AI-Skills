# Development origin. Use an HTTPS origin when hosting.
PUBLIC_URL=http://localhost:8788
PORT=8788
HOST=127.0.0.1
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
CONNECTOR_STORAGE_KEY=
CONNECTOR_DATABASE=data/connector.sqlite
# Optional for stdio only. Never put a Shopify token into an MCP URL.
SHOPIFY_SHOP=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_SCOPES=read_products,read_inventory,read_orders
