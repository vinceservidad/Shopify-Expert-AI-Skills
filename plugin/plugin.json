  "license": "MIT",
  "keywords": [
    "shopify",
    "virtual-assistant",
    "ecommerce",
    "mcp"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Shopify VA Toolkit",
        "shortDescription": "Shopify expert workflows",
        "developerName": "Vince Servidad",
        "category": "Productivity",
