{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "shopify-va-toolkit",
  "version": "0.2.1",
  "description": "Independent expert workflows and read-only Shopify tools for VAs, freelancers and store specialists.",
  "author": {
    "name": "Vince Servidad"
  },
  "homepage": "https://github.com/vinceservidad/Shopify-Expert-AI-Skills",
